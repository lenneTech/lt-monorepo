{
  // Mirrors nest-server's config rather than oxfmt's defaults, so a script that travels between
  // the base repos does not change shape on the way. `singleQuote` is the one setting all of them
  // already agree on; before this file existed, `scripts/` here was internally split — check.mjs
  // used double quotes, check-ci-consistency.mjs single — because nothing enforced either.
  //
  // printWidth 120 follows nest-server. nuxt-extensions uses 180; that is a Vue/SFC repo where
  // long template expressions are normal, and these scripts read like nest-server's.
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "ignorePatterns": ["node_modules", "projects", ".nuxt-check"]
}
